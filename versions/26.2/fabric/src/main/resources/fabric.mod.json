{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "contact": {
    "homepage": "${mod_url}",
    "sources": "${mod_url}",
    "issues": "${mod_issues}"
  },
  "license": "${mod_license}",
  "icon": "lathe.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.rinkynooble.lathe.fabric.LatheFabric"],
    "client": ["com.rinkynooble.lathe.fabric.LatheFabricClient"],
    "server": ["com.rinkynooble.lathe.fabric.LatheFabricServer"]
  },
  "mixins": ["lathe.mixins.json"],
  "depends": {
    "fabricloader": "${loader_version_range}",
    "minecraft": "${minecraft_version_range}",
    "java": ">=25",
    "fabric-api": "${fabric_api_version_range}"
  }
}
